# ─── API Keys ────────────────────────────────────────────────────────────────
# AbuseIPDB – https://www.abuseipdb.com/api
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# VirusTotal – https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# HetrixTools – https://hetrixtools.com/api/ (optional)
HETRIXTOOLS_API_KEY=your_hetrixtools_api_key_here

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
REPORT_EMAIL_FROM=your_email@gmail.com
REPORT_EMAIL_TO=recipient@example.com

# ─── Scheduling ──────────────────────────────────────────────────────────────
# Standard cron expression (default: 08:00 every day)
CRON_SCHEDULE=0 8 * * *
# IANA timezone string
CRON_TIMEZONE=UTC

# ─── Behaviour ───────────────────────────────────────────────────────────────
# Only send the email when something has changed since yesterday (true/false)
EMAIL_ONLY_ON_CHANGE=false

# Server port
PORT=3000
